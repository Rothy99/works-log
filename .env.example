# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Cloudflare D1 (used by the Hono customer / work-log API under /api/v1).
# Create an API token with "D1 Edit" permission at https://dash.cloudflare.com/profile/api-tokens
# The database ID is shown on the D1 page in the Cloudflare dashboard.
CF_ACCOUNT_ID="MY_CLOUDFLARE_ACCOUNT_ID"
CF_API_TOKEN="MY_CLOUDFLARE_API_TOKEN"
CF_D1_DATABASE_ID="MY_D1_DATABASE_ID"

# Cloudflare R2 (stores customer photos uploaded via POST /api/v1/uploads).
# Create an R2 API token with "Object Read & Write" permission for the bucket.
# https://dash.cloudflare.com/profile/api-tokens
# When these are missing, uploads fall back to the local ./data/uploads folder.
CF_R2_ACCESS_KEY_ID="MY_R2_ACCESS_KEY_ID"
CF_R2_SECRET_ACCESS_KEY="MY_R2_SECRET_ACCESS_KEY"
CF_R2_BUCKET="MY_R2_BUCKET_NAME"
# Optional: custom S3 endpoint for R2 (defaults to https://<CF_ACCOUNT_ID>.r2.cloudflarestorage.com).
# Set CF_R2_ENDPOINT to point at an S3-compatible emulator in local tests.
# CF_R2_ENDPOINT="https://myaccount.r2.cloudflarestorage.com"
# Optional: set to "local" to force the local filesystem store even when R2 is configured.
# CF_R2_MODE="local"
